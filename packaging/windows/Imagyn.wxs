<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX source for the Imagyn MSI.

  Built by scripts/package_windows.ps1 with WiX v4:

    wix build -arch x64 -d Version=0.1.0 -d SourceDir=<bundle> ^
      -d IconFile=<ico> -o imagyn-0.1.0-windows-x64.msi Imagyn.wxs

  The <Files> element harvests the whole Flutter bundle, so there is no
  heat.exe step and no component list to keep in sync. No UI extension is
  referenced, which keeps the build to the core WiX package alone.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Imagyn"
           Manufacturer="Dai2010"
           Version="$(Version)"
           UpgradeCode="1E9B7D24-5C68-4A31-9F02-B7D3E5A8602C"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Minimalist AI image studio" Manufacturer="Dai2010" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Imagyn is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="ImagynIcon.ico" SourceFile="$(IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ImagynIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Dai2010/imagyn" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Imagyn" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="Imagyn" />
    </StandardDirectory>

    <Feature Id="Main" Title="Imagyn" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(SourceDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppShortcutFolder" Guid="B6C2A8F1-40D7-4E95-8C13-7A5F2D9E6B04">
      <Shortcut Id="AppShortcut"
                Name="Imagyn"
                Description="Minimalist AI image studio"
                Target="[INSTALLFOLDER]imagyn.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Dai2010\Imagyn" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
