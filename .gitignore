# Flutter and Dart build output.
/.dart_tool/
/.flutter-plugins*
/build/
/coverage/

# Python bytecode from scripts/*.py.
__pycache__/
*.pyc

# Signing material: never committed, in any directory.
*.jks
*.keystore
key.properties
.env

.idea/
.DS_Store

# Generated by scripts/scaffold_platforms.py. These rules are anchored at the
# repository root on purpose: an unanchored `android/` also matches
# platform/android/, which is where the files this app actually owns live —
# the media-save channel and the launcher icons. Ignoring those would ship an
# APK whose export button throws MissingPluginException.
/android/
/linux/
/windows/
/macos/
